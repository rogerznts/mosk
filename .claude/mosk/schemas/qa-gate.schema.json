{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosk.dev/schemas/qa-gate.schema.json",
  "title": "MOSK quality gate",
  "type": "object",
  "required": [
    "schema", "story", "story_title", "gate", "quality_score", "score_history",
    "status_reason", "reviewer", "updated", "waiver_active",
    "waiver_reason", "waiver_approved_by", "waiver_approved_at"
  ],
  "properties": {
    "schema": { "enum": [1, 2] },
    "story": { "type": "string", "minLength": 1 },
    "story_title": { "type": "string", "minLength": 1 },
    "gate": { "enum": ["PASS", "CONCERNS", "FAIL", "WAIVED"] },
    "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "score_history": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0, "maximum": 100 }
    },
    "status_reason": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "format": "date-time" },
    "evidence_ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "waiver_active": { "type": "boolean" },
    "waiver_reason": { "type": "string" },
    "waiver_approved_by": { "type": "string" },
    "waiver_approved_at": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "schema": { "const": 2 } }, "required": ["schema"] },
      "then": { "required": ["evidence_ref"] }
    },
    {
      "if": { "properties": { "gate": { "const": "WAIVED" } }, "required": ["gate"] },
      "then": {
        "properties": { "waiver_active": { "const": true } },
        "required": ["waiver_reason", "waiver_approved_by", "waiver_approved_at"]
      }
    }
  ],
  "additionalProperties": true
}
