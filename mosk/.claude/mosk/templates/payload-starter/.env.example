# .env do projeto — GERADO automaticamente pelo modo /mosk-bench (FR-009).
# O usuário leigo NUNCA precisa editar nada aqui. Este exemplo documenta as chaves.
#
# Os hosts `postgres` e `redis` resolvem dentro da rede `mosk-net` (infra compartilhada).

# Banco Postgres próprio deste projeto (slug sanitizado [a-z0-9_]), no servidor compartilhado.
DATABASE_URI=postgresql://mosk:mosk@postgres:5432/nome_do_projeto

# Índice Redis próprio deste projeto (0-15) OU, em fallback, prefixo de chave.
REDIS_URL=redis://redis:6379/0

# Segredo do Payload — gerado por projeto (aleatório) na criação do .env.
PAYLOAD_SECRET=troque-por-um-segredo-aleatorio-gerado

# Porta livre do admin no host — alocada por bind-test e gravada no registry.yaml.
ADMIN_PORT=3000
